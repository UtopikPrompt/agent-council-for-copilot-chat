    "languageModelTools": [
      {
        "name": "utopikAgentCouncil_reportActivity",
        "displayName": "Report Council Activity",
        "userDescription": "Report a council agent handoff to the local office view.",
        "modelDescription": "Record a reported lifecycle event for a contributed agent handoff. Every agent-tool edge needs its own separate dispatching and returned/failed report pair: an Orchestrator-to-Advisor report does not cover the Advisor-to-Specialist edge. Immediately before each agent invocation, report dispatching with the target agent and delegatedBy set to your own canonical agent name; capture its returned runId. After that same invocation completes, report returned or failed with the same target, delegatedBy, and exact runId. Never reuse an outer handoff's runId, skip a report, invent a runId, or include task prompts, results, file paths, source content, or secrets. These reports are not independent verification of Copilot runtime activity.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "reportCouncilActivity",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "dispatching",
                "returned",
                "failed"
              ],
              "description": "Use dispatching before delegation, then returned or failed after the agent tool responds."
            },
            "agent": {
              "type": "string",
              "description": "Exact canonical name of the contributed agent being invoked."
            },
            "delegatedBy": {
              "type": "string",
              "description": "Exact canonical name of the agent invoking the target, such as Orchestrator or a domain Advisor."
            },
            "runId": {
              "type": "string",
              "description": "Optional. Omit for a unique active handoff. If multiple handoffs for the same target and delegator are active, use the exact ID returned by the matching dispatch report; never invent one."
            }
          },
          "required": [
            "action",
            "agent",
            "delegatedBy"
          ],
          "additionalProperties": false
        }
      }
    ],
    "viewsContainers": {
      "panel": [
