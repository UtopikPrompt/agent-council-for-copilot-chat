{
    "name": "agent-roster-for-copilot-chat",
    "displayName": "Agent Roster for Copilot Chat",
    "description": "A specialist agent roster and reusable workflow skills for GitHub Copilot Chat.",
    "icon": "assets/extension-icon.png",
    "version": "0.0.0",
    "publisher": "UtopikPrompt",
    "main": "./src/extension.js",
    "activationEvents": [
        "onCommand:agentRoster.openModelLearning",
        "onView:agentRoster.modelLearning",
        "onLanguageModelTool:aroGetModelRecommendations",
        "onLanguageModelTool:aroRecordModelOutcome"
    ],
    "license": "PolyForm-Noncommercial-1.0.0",
    "engines": {
        "vscode": "^1.111.0"
    },
    "extensionDependencies": [
        "GitHub.copilot-chat"
    ],
    "categories": [
        "AI",
        "Chat"
    ],
    "keywords": [
        "copilot",
        "agents",
        "skills",
        "orchestrator"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/UtopikPrompt/agent-roster-for-copilot-chat.git"
    },
    "scripts": {
        "test": "node --test",
        "lint": "node scripts/validate.mjs",
        "vscode:prepublish": "npm test && npm run lint",
        "package": "vsce package"
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "agentRoster",
                    "title": "Agent Roster",
                    "icon": "assets/aro-wireframe.svg"
                }
            ]
        },
        "views": {
            "agentRoster": [
                {
                    "id": "agentRoster.modelLearning",
                    "name": "Aro Learning"
                }
            ]
        },
        "commands": [
            {
                "command": "agentRoster.openModelLearning",
                "title": "Agent Roster: Open Aro Learning"
            }
        ],
        "languageModelTools": [
            {
                "name": "aroGetModelRecommendations",
                "displayName": "Read Aro model recommendations",
                "toolReferenceName": "aroGetModelRecommendations",
                "canBeReferencedInPrompt": true,
                "userDescription": "Read locally learned model recommendations for a specialist role and task type.",
                "modelDescription": "Read Aro's profile-local model outcome history for the given role and task category. Returns available models with requested model IDs, native or snapshot price tiers, success/failure counts, Bayesian score, and a recommendation when at least two outcomes exist. Call this before selecting a subagent model. It does not send prompts to models and does not change Aro's main model.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "role": {
                            "type": "string",
                            "enum": [
                                "advisor",
                                "coding",
                                "documentation",
                                "infrastructure",
                                "review"
                            ]
                        },
                        "taskCategory": {
                            "type": "string",
                            "enum": [
                                "simple",
                                "standard",
                                "complex"
                            ]
                        }
                    },
                    "required": [
                        "role",
                        "taskCategory"
                    ],
                    "additionalProperties": false
                }
            },
            {
                "name": "aroRecordModelOutcome",
                "displayName": "Record Aro model outcome",
                "toolReferenceName": "aroRecordModelOutcome",
                "canBeReferencedInPrompt": true,
                "userDescription": "Record a verified subagent result for future model recommendations.",
                "modelDescription": "Update Aro's local model scorecard after a specialist call. Record success only after acceptance checks pass. Record failure only when there is concrete evidence the requested model produced an incorrect, incomplete, acceptance-failing, or unsafe result. Do not blame the model for missing input, incorrect routing, tool failure, rejected requests, or environment issues. Never send prompts or response text; provide only the requested model ID and a fixed evidence code.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "role": {
                            "type": "string",
                            "enum": [
                                "advisor",
                                "coding",
                                "documentation",
                                "infrastructure",
                                "review"
                            ]
                        },
                        "taskCategory": {
                            "type": "string",
                            "enum": [
                                "simple",
                                "standard",
                                "complex"
                            ]
                        },
                        "modelId": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "outcome": {
                            "type": "string",
                            "enum": [
                                "success",
                                "failure"
                            ]
                        },
                        "evidenceCode": {
                            "type": "string",
                            "enum": [
                                "acceptance_passed",
                                "incorrect",
                                "incomplete",
                                "acceptance_failed",
                                "unsafe"
                            ]
                        },
                        "worker": {
                            "type": "string",
                            "maxLength": 100
                        }
                    },
                    "required": [
                        "role",
                        "taskCategory",
                        "modelId",
                        "outcome",
                        "evidenceCode"
                    ],
                    "additionalProperties": false
                }
            }
        ],
