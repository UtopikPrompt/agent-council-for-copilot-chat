{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (VS Code 1.146)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/.vscode-test/vscode-win32-x64-archive-1.146.0/Code.exe",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}